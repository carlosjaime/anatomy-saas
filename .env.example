# ── Base de datos (cuentas, suscripciones, progreso) ─────────────────────────
# Vercel / Node: obligatoria en producción (p. ej. Turso). En desarrollo, si se
# omite, se usa file:.data/atlas.db. En Cloudflare se usa el binding D1 "DB".
DATABASE_URL=libsql://tu-base.turso.io
DATABASE_AUTH_TOKEN=

# URL pública: enlaces de correo y regreso desde Mercado Pago.
APP_URL=https://tu-dominio.mx

# ── Pagos: Mercado Pago Suscripciones ────────────────────────────────────────
# Access token de la aplicación (TEST-… en sandbox, APP_USR-… en producción).
# Sin él: en desarrollo se usa un proveedor de demostración; en producción los
# pagos se desactivan (503).
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta de Webhooks (Tus integraciones → Webhooks). Obligatoria en producción.
# URL a registrar: https://tu-dominio.mx/api/billing/webhook
# Eventos: "Planes y suscripciones" (subscription_preapproval y subscription_authorized_payment).
MERCADOPAGO_WEBHOOK_SECRET=

# ── Correo transaccional: Resend ─────────────────────────────────────────────
# Sin clave: en desarrollo los correos se imprimen en la consola del servidor.
RESEND_API_KEY=
EMAIL_FROM="Atlas Anatómico <no-reply@tu-dominio.mx>"
