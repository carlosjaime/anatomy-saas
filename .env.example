# Base de datos libSQL/SQLite para cuentas y progreso (Vercel / Node).
# Desarrollo local: si se omite, se usa file:.data/atlas.db automáticamente.
# Producción en Vercel: obligatoria (p. ej. una base de Turso).
DATABASE_URL=libsql://tu-base.turso.io
DATABASE_AUTH_TOKEN=

# En Cloudflare (vinext) se usa el binding D1 "DB" declarado en .openai/hosting.json.
