# ── Base de datos (cuentas, suscripciones, progreso) ─────────────────────────
# Vercel / Node: obligatoria en producción (p. ej. Turso). En desarrollo, si se
# omite, se usa file:.data/atlas.db. En Cloudflare se usa el binding D1 "DB".
DATABASE_URL=libsql://tu-base.turso.io
DATABASE_AUTH_TOKEN=

# URL pública: enlaces de correo y retorno desde PayPal.
APP_URL=https://tu-dominio.mx

# ── Pagos: PayPal Subscriptions ──────────────────────────────────────────────
# Credenciales REST de la app (developer.paypal.com → Apps & Credentials).
# Solo servidor: nunca se envían al navegador. Sin ellas: en desarrollo se usa
# un proveedor de demostración; en producción los pagos se desactivan (503).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (predeterminado) o live. Cualquier otro valor desactiva los pagos.
PAYPAL_ENVIRONMENT=sandbox
# Id del webhook registrado en PayPal para https://tu-dominio.mx/api/billing/webhooks/paypal
# Eventos: BILLING.SUBSCRIPTION.* y PAYMENT.SALE.COMPLETED/REFUNDED/REVERSED.
PAYPAL_WEBHOOK_ID=
# Ids de planes de PayPal por plan y ciclo. Se generan con `npm run paypal:setup`
# a partir de app/lib/plans.ts y se comprueban con `npm run paypal:setup -- --verify`.
# PAYPAL_PLAN_IDS='{"student:monthly":"P-…","student:annual":"P-…","pro:monthly":"P-…","pro:annual":"P-…","institution:monthly":"P-…","institution:annual":"P-…"}'
PAYPAL_PLAN_IDS=

# ── Correo transaccional: Resend ─────────────────────────────────────────────
# Sin clave: en desarrollo los correos se imprimen en la consola del servidor.
RESEND_API_KEY=
EMAIL_FROM="Atlas Anatómico <no-reply@tu-dominio.mx>"

# ── Pruebas E2E (solo local/CI) ──────────────────────────────────────────────
# Habilita pagos de demostración y el buzón /api/test/mailbox con un build de
# producción. Se ignora si VERCEL_ENV=production o hay credenciales reales.
# ATLAS_E2E=1
